# Copie para .kamal/secrets e preencha. O .kamal/secrets NUNCA vai para o git (está no .gitignore).

# Token de acesso do Docker Hub (Account settings > Personal access tokens), permissão Read & Write
KAMAL_REGISTRY_PASSWORD=

# Segredo do Auth.js para assinar a sessão do front (gere com: openssl rand -base64 32)
AUTH_SECRET=

# Senha do usuário "admin" do console do Keycloak (master realm)
KC_BOOTSTRAP_ADMIN_PASSWORD=

# Segredo do client confidencial tarefas-api (cadastro de usuários pela Admin API).
# Só é aplicado na PRIMEIRA importação do realm; para trocar depois, altere também no Keycloak
# (Clients > tarefas-api > Credentials) e reinicie a API.
KEYCLOAK_ADMIN_CLIENT_SECRET=
