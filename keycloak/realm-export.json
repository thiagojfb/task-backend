      "lastName": "Silva",
      "email": "ana@exemplo.com.br",
      "credentials": [
        { "type": "password", "value": "senha123", "temporary": false }
      ],
      "realmRoles": ["usuario"]
    },
    {
      "username": "bruno",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bruno",
      "lastName": "Souza",
      "email": "bruno@exemplo.com.br",
      "credentials": [
        { "type": "password", "value": "senha123", "temporary": false }
      ],
      "realmRoles": ["usuario"]
    },
    {
      "username": "semnome",
      "enabled": true,
      "emailVerified": true,
      "email": "semnome@exemplo.com.br",
      "credentials": [
        { "type": "password", "value": "senha123", "temporary": false }
      ],
      "realmRoles": ["usuario"]
    },
    {
      "username": "visitante",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Visitante",
      "lastName": "Sem Papel",
      "email": "visitante@exemplo.com.br",
